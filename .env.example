# API tương thích OpenAI (dùng chung cấu hình với minder-internal-operation: proxy LiteLLM).
# Để trống OPENAI_API_KEY: trợ lý và M6 chạy bằng câu trả lời soạn sẵn (chế độ offline).
OPENAI_API_KEY=
# Mặc định https://api.openai.com/v1. Bản dùng cho khách nên là địa chỉ https.
OPENAI_BASE_URL=

# Model cho trợ lý và M6 (mặc định gpt-5-mini).
CHAT_MODEL=gpt-5-mini

# Giá ước tính (USD / 1 triệu token) để tính trần chi phí; mặc định theo gpt-5-mini.
# CHAT_PRICE_IN=0.25
# CHAT_PRICE_OUT=2
# CHAT_PRICE_CACHED=0.025

# Trần chi phí theo ngày cho trợ lý, tính bằng USD. Chạm trần thì chuyển sang câu trả lời soạn sẵn.
CHAT_DAILY_BUDGET=5

# Nhật ký câu hỏi chat: off (mặc định) hoặc on. Khi on, chỉ lưu câu hỏi và thời gian vào .data/chat-log.jsonl.
CHAT_LOG=off

# Mã truy cập tùy chọn. Để trống thì không khóa trang.
ACCESS_CODE=

# Địa chỉ trang, dùng cho mã QR ở chế độ trình chiếu.
SITE_URL=http://localhost:3000
