# API tương thích OpenAI (dùng chung cấu hình với minder-internal-operation: proxy LiteLLM).
# Để trống OPENAI_API_KEY: trợ lý và M6 chạy bằng câu trả lời soạn sẵn (chế độ offline).
OPENAI_API_KEY=
# Mặc định https://api.openai.com/v1. Bản dùng cho khách nên là địa chỉ https.
OPENAI_BASE_URL=

# Model cho trợ lý và M6 (mặc định gpt-5-mini).
CHAT_MODEL=gpt-5-mini

# Giá ước tính (USD / 1 triệu token) để tính trần chi phí; mặc định theo gpt-5-mini.
# CHAT_PRICE_IN=0.25
# CHAT_PRICE_OUT=2
# CHAT_PRICE_CACHED=0.025

# Trần chi phí theo ngày cho trợ lý, tính bằng USD, tính RIÊNG cho từng deck.
# Chạm trần thì deck đó chuyển sang câu trả lời soạn sẵn. Đặt riêng một deck: CHAT_DAILY_BUDGET_<SLUG> (slug viết hoa, "-" thành "_").
CHAT_DAILY_BUDGET=5
# CHAT_DAILY_BUDGET_HOA_PHAT=5
# CHAT_DAILY_BUDGET_NESTLE_VIETNAM=5

# Nhật ký câu hỏi chat: off (mặc định) hoặc on. Khi on, chỉ lưu câu hỏi và thời gian vào .data/<deck>/chat-log.jsonl.
CHAT_LOG=off

# Mã truy cập theo từng deck (mỗi khách hàng một mã; mã của khách hàng này không mở được deck khác).
# Để trống thì deck đó không khóa. ACCESS_CODE (cũ) chỉ còn dùng cho /hoa-phat khi chưa đặt ACCESS_CODE_HOA_PHAT.
ACCESS_CODE_HOA_PHAT=
ACCESS_CODE_NESTLE_VIETNAM=
ACCESS_CODE_ISUZU_VIETNAM=
ACCESS_CODE=

# Địa chỉ trang, dùng cho mã QR ở chế độ trình chiếu.
SITE_URL=http://localhost:3000
